# Optional public same-origin contact API path. Leave empty for local drafts only.
# Configure a real backend before setting this; no server is included in this Vite app.
# Example approved path: /api/contact
VITE_CONTACT_ENDPOINT=
# Public deployment origin for prerendered canonicals and sitemap URLs.
# Leave empty locally. Use only the confirmed deployment URL; no credentials.
VITE_SITE_URL=
